rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsUserData(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // The failure prefix is reserved for the emulator-only 4J receiver test.
    // It forces the atomic transaction to fail without weakening production
    // rules or requiring a production credential.
    match /users/{userId}/transactions/{document} {
      allow read: if ownsUserData(userId);
      allow write: if ownsUserData(userId)
        && !document.matches('runtime-failure_.*');
    }

    match /users/{userId}/{collection}/{document=**} {
      allow read, write: if ownsUserData(userId)
        && collection != 'transactions';
    }
  }
}
