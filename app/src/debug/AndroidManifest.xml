<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Firebase Emulator endpoints are local HTTP services. This override is
         compiled into debug builds only; release keeps the production policy. -->
    <application android:usesCleartextTraffic="true">
        <!-- Instrumentation container; renders the existing support UI unchanged. -->
        <activity android:name="androidx.activity.ComponentActivity" android:exported="false" tools:replace="android:exported" />

        <!-- Replace Firebase's library auto-init only in debug builds. The
             provider below either performs the normal resource-based init or,
             when the explicit build flag is true, initializes the default app
             against the isolated demo project before any receiver can run. -->
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            tools:node="remove" />

        <provider
            android:name=".testing.DebugFirebaseInitProvider"
            android:authorities="${applicationId}.debug-firebase-init"
            android:exported="false"
            android:initOrder="101" />
    </application>

</manifest>
